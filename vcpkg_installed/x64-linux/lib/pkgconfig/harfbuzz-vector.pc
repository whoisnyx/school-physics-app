prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: harfbuzz-vector
Description: HarfBuzz vector converter
Version: 14.4.0

Libs: "-L${libdir}" -lharfbuzz-vector -lm -lharfbuzz -pthread
Requires: freetype2 >=  20.0.14, harfbuzz =  14.4.0
Cflags: "-I${includedir}/harfbuzz" -pthread
