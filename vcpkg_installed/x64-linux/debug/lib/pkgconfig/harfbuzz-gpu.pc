prefix=${pcfiledir}/../..
includedir=${prefix}/../include
libdir=${prefix}/lib

Name: harfbuzz-gpu
Description: HarfBuzz GPU rasterization library
Version: 14.4.0

Libs: "-L${libdir}" -lharfbuzz-gpu -lm -lharfbuzz -pthread
Requires: freetype2 >=  20.0.14, harfbuzz =  14.4.0
Cflags: "-I${includedir}/harfbuzz" -pthread
